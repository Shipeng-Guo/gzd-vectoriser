{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline vector comparison report manifest",
  "description": "Additional cross-file hash, region-bounds, ID, verdict and review-gate checks are enforced by build_report.py. File paths are relative to this manifest.",
  "type": "object",
  "required": [
    "version",
    "title",
    "canvas",
    "source",
    "final_svg",
    "final_render"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "canvas": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "final_svg": {
      "type": "string",
      "minLength": 1
    },
    "final_render": {
      "type": "string",
      "minLength": 1
    },
    "before_render": {
      "type": "string",
      "minLength": 1
    },
    "assets_zip": {
      "type": "string",
      "minLength": 1
    },
    "ledger": {
      "type": "string",
      "minLength": 1
    },
    "scan": {
      "type": "string",
      "minLength": 1
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "box_xyxy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "box_xyxy": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "verdict": {
            "enum": [
              "open",
              "reviewing",
              "fix_required",
              "uncertain",
              "pass",
              "allowed_difference"
            ],
            "default": "uncertain"
          },
          "summary": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "ledger_id": {
            "type": "string",
            "minLength": 1,
            "description": "Optional ledger item ID; defaults to display id. Display box must be contained in that recorded box."
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "detail"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string"
          }
        }
      }
    },
    "allowed_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "dependentRequired": {
    "ledger": [
      "scan"
    ],
    "scan": [
      "ledger"
    ]
  }
}